# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
# Password for the lecturer console (start, pause, end, export). Viewers never need it.
# Leave empty only when the server listens on 127.0.0.1. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(16))"
LECTURER_SECRET=

# ---------------------------------------------------------------------------
# Live captions (speech-to-text)
# ---------------------------------------------------------------------------
# Local models: nemotron (fastest and lightest) | parakeet (default, fast, 25 languages)
#   | whisper-turbo (99 languages, wants a GPU) | whisper-small | voxtral (best accuracy, NVIDIA GPU ~16 GB,
#   needs: pip install -r requirements-voxtral.txt)
STT_LOCAL_MODEL=parakeet
# auto, or a language code such as de / en
STT_DEFAULT_LANGUAGE=de
# Where downloaded models are stored (each is downloaded on first use: Parakeet ~465 MB, Nemotron ~475 MB, Voxtral ~9 GB)
STT_MODEL_DIR=./data/models
# auto (use the NVIDIA GPU if it works) | cuda | cpu. Applies to the Whisper and Voxtral models.
STT_DEVICE=auto
# 0 = choose automatically
STT_THREADS=0
# Load the default local model at startup so the first caption is instant
STT_PRELOAD=true
STT_MAX_SESSIONS=3
STT_SESSION_RETENTION_HOURS=12

# Optional: Claude tidies punctuation of finished sentences (text only, never audio).
# Hidden in the console unless a key is set.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# End-of-lecture analysis for the professor (uses the same ANTHROPIC_API_KEY).
# When the session ends, the transcript text is sent to Anthropic once; audio never is.
CLAUDE_ANALYSIS_MODEL=claude-opus-5-5
