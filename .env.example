# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
# Password for the lecturer console (start, pause, end, export). Viewers never need it.
# Leave empty only when the server listens on 127.0.0.1. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(16))"
LECTURER_SECRET=

# ---------------------------------------------------------------------------
# Live captions (speech-to-text)
# ---------------------------------------------------------------------------
# Engine the console preselects: local | openai | mistral
STT_DEFAULT_ENGINE=local
# Local models: parakeet (default, fast, 25 languages) | whisper-turbo (99 languages, wants a GPU) | whisper-small
STT_LOCAL_MODEL=parakeet
# auto, or a language code such as de / en
STT_DEFAULT_LANGUAGE=de
# Where downloaded models are stored (Parakeet is ~465 MB, downloaded on first use)
STT_MODEL_DIR=./data/models
# auto (use the NVIDIA GPU if it works) | cuda | cpu. Applies to the Whisper models.
STT_DEVICE=auto
# 0 = choose automatically
STT_THREADS=0
# Load the default local model at startup so the first caption is instant
STT_PRELOAD=true
STT_MAX_SESSIONS=3
STT_SESSION_RETENTION_HOURS=12

# Cloud engine: OpenAI Whisper. Leave empty to disable. The key stays on the server, browsers never see it.
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-realtime-whisper

# Optional extras (hidden in the console unless a key is set)
MISTRAL_API_KEY=
MISTRAL_STT_MODEL=voxtral-mini-transcribe-realtime-3
MISTRAL_STT_DELAY_MS=480
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
